<script>
    const TOKEN='WrySS4WWywOf5hRW5QZdDU6TR7TU38L4cthoMRxSBz0=';
    const SHOP_ID='59632';
    const PROXY='https://cors-anywhere.herokuapp.com/';
    const FINANCE_URL=`https://api-seller.uzum.uz/api/seller-openapi/v1/finance/orders?page=0&size=100&shopIds=${SHOP_ID}`;
    const BALANCE_URL=`https://api-seller.uzum.uz/api/seller-openapi/v1/finance/balance`;

    let MANUAL_PRICES = JSON.parse(localStorage.getItem('uzum_manual_prices')) || {};
    let currentOrders = [], fboList = [], salesChart, usdRateValue = 13000;

    const STATUS_RU={'PROCESSING':'Сборка','CANCELED':'Отмена','COMPLETED':'Выдан','WAITING':'Ожидание','DELIVERED':'Доставлен','RETURNED':'Возврат','TO_WITHDRAW':'Готов'};

    async function fetchFullData(){
        try {
            document.getElementById('updateStatus').innerText="Синхронизация...";
            const headers={'Authorization':TOKEN,'Accept':'application/json'};
            const [ordersRes, balanceRes, cbuRes] = await Promise.all([
                fetch(PROXY+FINANCE_URL,{headers}).then(r=>r.json()).catch(()=>({})),
                fetch(PROXY+BALANCE_URL,{headers}).then(r=>r.json()).catch(()=>({})),
                fetch('https://cbu.uz/ru/arkhiv-kursov-valyut/json/').then(r=>r.json())
            ]);

            currentOrders = ordersRes.orderItems || [];
            usdRateValue = parseFloat(cbuRes.find(c=>c.Code==='840').Rate);
            
            document.getElementById('courseIndicator').innerText = `$1 = ${usdRateValue.toLocaleString()} UZS`;
            document.getElementById('apiBalance').innerText = (balanceRes.availableAmount || 0).toLocaleString() + ' сум';
            
            renderData(currentOrders);
            document.getElementById('updateStatus').innerText = `ID: 59632 • ${new Date().toLocaleTimeString()}`;
        } catch(err) {
            document.getElementById('updateStatus').innerText="Ошибка API";
        }
    }

    function getPurchasePrice(title){
        if(!title) return 0;
        const cleanTitle=String(title).toLowerCase().replace(/[^a-z0-9а-яё]/gi,'');
        for(let key in MANUAL_PRICES){
            const cleanKey=String(key).toLowerCase().replace(/[^a-z0-9а-яё]/gi,'');
            if(cleanTitle.includes(cleanKey)) return MANUAL_PRICES[key];
        }
        return 0;
    }

    function renderData(items){
        const daysLimit=parseInt(document.getElementById('timeFilter').value);
        const msLimit=daysLimit*24*60*60*1000;
        const now=new Date().getTime();

        let stats={withdraw:0,cost:0,net:0,labels:[],values:[],done:0,cancel:0};
        const tbody=document.getElementById('ordersTable');
        const riskDiv=document.getElementById('riskTable');
        tbody.innerHTML=''; riskDiv.innerHTML='';

        items.filter(item=>(now-item.date)<msLimit).forEach(item=>{
            const isCanceled=(item.status==='CANCELED'||item.status==='RETURNED');
            const purchase=getPurchasePrice(item.productTitle);
            const profit=item.sellerProfit||0;
            const rowNet=isCanceled?0:(profit-purchase);

            if(!isCanceled){
                stats.withdraw+=profit; stats.cost+=purchase; stats.net+=rowNet; stats.done++;
                stats.labels.unshift(new Date(item.date).toLocaleDateString());
                stats.values.unshift(item.sellPrice||0);
            } else stats.cancel++;

            tbody.innerHTML+=`
                <tr class="hover:bg-slate-800/40 ${isCanceled?'opacity-30':''}">
                    <td class="p-5 font-bold text-xs truncate max-w-[250px]">${item.productTitle}</td>
                    <td class="p-5 text-[9px] uppercase font-black text-purple-400">${STATUS_RU[item.status]||item.status}</td>
                    <td class="p-5 text-xs text-slate-500">${new Date(item.date).toLocaleDateString()}</td>
                    <td class="p-5 text-xs font-mono font-bold">${(item.sellPrice||0).toLocaleString()}</td>
                    <td class="p-5 text-xs font-bold text-orange-400">${purchase.toLocaleString()}</td>
                    <td class="p-5 text-xs font-bold text-emerald-400">${rowNet.toLocaleString()}</td>
                </tr>`;
            
            if(!isCanceled && purchase>0 && (rowNet/purchase*100) < 30) {
                riskDiv.innerHTML += `<div class="bg-slate-900 p-4 rounded-2xl border-l-4 border-red-500 flex justify-between items-center text-[10px]"><span>${item.productTitle}</span><span class="text-red-400 font-black">ROI ${(rowNet/purchase*100).toFixed(1)}%</span></div>`;
            }
        });

        document.getElementById('toWithdraw').innerText=stats.withdraw.toLocaleString()+' сум';
        document.getElementById('totalCost').innerText=stats.cost.toLocaleString()+' сум';
        document.getElementById('netProfit').innerText=stats.net.toLocaleString()+' сум';
        document.getElementById('roi').innerText=(stats.cost>0?(stats.net/stats.cost*100):0).toFixed(1)+'%';
        
        updateChart(stats.labels, stats.values);
        updateAI(stats);
    }

    function updateAI(stats){
        const taskbar = document.getElementById('taskbar');
        taskbar.innerHTML = '';
        if (stats.cancel > (stats.done * 0.2)) addAiTask('⚠️ Много отмен! Проверь товар.', 'danger');
        if (stats.done > 10) addAiTask('🚀 Хороший темп продаж за период!', 'success');
        if (!taskbar.innerHTML) taskbar.innerHTML = '<p class="text-[10px] text-slate-500 italic">Жду данных...</p>';
    }

    function addAiTask(text,type){
        const colors={'danger':'border-red-500 bg-red-500/10 text-red-200','success':'border-emerald-500 bg-emerald-500/10 text-emerald-200'};
        document.getElementById('taskbar').innerHTML+=`<div class="ai-card p-3 rounded-xl border ${colors[type]} text-[10px] font-bold shadow-sm">${text}</div>`;
    }

    function updateChart(labels,data){
        if(salesChart) salesChart.destroy();
        salesChart=new Chart(document.getElementById('salesChart').getContext('2d'),{
            type:'line',
            data:{labels,datasets:[{data,borderColor:'#9333ea',borderWidth:3,pointRadius:0,fill:true,tension:0.4,backgroundColor:'rgba(147,51,234,0.1)'}]},
            options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{display:false},x:{ticks:{color:'#475569',size:10}}}}
        });
    }

    function openRoiModal(){ document.getElementById('roiModal').classList.remove('hidden'); switchTab('fbo'); }
    function closeRoiModal(){ document.getElementById('roiModal').classList.add('hidden'); }

    function switchTab(tab){
        ['analytics','fbo','prices'].forEach(t=>{
            document.getElementById(`tab-${t}`).classList.add('hidden');
            document.getElementById(`tab-btn-${t}`).classList.remove('tab-active');
        });
        document.getElementById(`tab-${tab}`).classList.remove('hidden');
        document.getElementById(`tab-btn-${tab}`).classList.add('tab-active');
        if(tab==='fbo') fillFboSelect();
        if(tab==='prices') renderManualPriceList();
    }

    // --- ЛОГИКА БАЗЫ ЦЕН ---
    function renderManualPriceList(){
        const tbody=document.getElementById('manualPriceList'); tbody.innerHTML='';
        for(let key in MANUAL_PRICES){
            const uzs = MANUAL_PRICES[key];
            const usd = (uzs / usdRateValue).toFixed(2);
            tbody.innerHTML+=`
                <tr class="hover:bg-slate-800/30">
                    <td class="p-4 font-bold text-white text-xs">${key}</td>
                    <td class="p-4 font-mono text-orange-400">${uzs.toLocaleString()} сум</td>
                    <td class="p-4 font-mono text-purple-400 font-black">$ ${usd}</td>
                    <td class="p-4 text-right"><button onclick="deletePrice('${key}')" class="text-red-500 font-black">✕</button></td>
                </tr>`;
        }
    }

    function addManualPrice(){
        const key = document.getElementById('newPriceKey').value;
        let val = parseFloat(document.getElementById('newPriceValue').value);
        if(!key || !val) return;
        if(document.getElementById('currencySelect').value === 'USD') val = val * usdRateValue;
        MANUAL_PRICES[key] = val;
        localStorage.setItem('uzum_manual_prices', JSON.stringify(MANUAL_PRICES));
        renderManualPriceList(); renderData(currentOrders);
    }

    function deletePrice(key){
        delete MANUAL_PRICES[key];
        localStorage.setItem('uzum_manual_prices', JSON.stringify(MANUAL_PRICES));
        renderManualPriceList();
    }

    // --- ЛОГИКА FBO ПЛАНА ---
    function fillFboSelect(){
        const select = document.getElementById('fboItemSelect');
        const unique = [...new Set(currentOrders.map(o => o.productTitle))];
        select.innerHTML = unique.map(t => {
            const p = currentOrders.find(o => o.productTitle === t).sellPrice;
            return `<option value="${t}" data-price="${p}">${t} (${p.toLocaleString()} сум)</option>`;
        }).join('');
    }

    function addToFboList(){
        const select = document.getElementById('fboItemSelect');
        const title = select.value;
        const sellPrice = parseFloat(select.options[select.selectedIndex].dataset.price);
        const qty = parseInt(document.getElementById('fboQuantity').value);
        
        const purchaseUZS = getPurchasePrice(title);
        const commission = sellPrice * 0.10; 
        const logist = 15000;
        const netUZS = (sellPrice - commission - logist - purchaseUZS);

        fboList.push({
            title, 
            qty, 
            sellPrice,
            purchaseUZS: purchaseUZS * qty, 
            purchaseUSD: (purchaseUZS * qty / usdRateValue).toFixed(2),
            netUZS: netUZS * qty,
            netUSD: (netUZS * qty / usdRateValue).toFixed(2)
        });
        renderFboTable();
    }

    function renderFboTable(){
        const tbody = document.getElementById('fboTableBody'); tbody.innerHTML = '';
        let tQty=0, tCost=0, tNet=0;
        
        fboList.forEach((item, index) => {
            tQty+=item.qty; tCost+=item.purchaseUZS; tNet+=item.netUZS;
            tbody.innerHTML += `
                <tr class="hover:bg-slate-800/40 transition-all">
                    <td class="p-5 font-bold text-slate-300 text-xs">${item.title}</td>
                    <td class="p-5 text-center font-black">${item.qty} шт</td>
                    <td class="p-5 font-mono text-slate-400">${item.sellPrice.toLocaleString()}</td>
                    <td class="p-5 font-mono">
                        <div class="text-orange-400 font-bold">${item.purchaseUZS.toLocaleString()} сум</div>
                        <div class="text-purple-400 text-[10px]">$ ${item.purchaseUSD}</div>
                    </td>
                    <td class="p-5 font-mono">
                        <div class="text-emerald-400 font-black">${item.netUZS.toLocaleString()} сум</div>
                        <div class="text-purple-400 text-[10px] font-bold">$ ${item.netUSD}</div>
                    </td>
                    <td class="p-5 text-right"><button onclick="fboList.splice(${index},1);renderFboTable();" class="text-red-500 font-black">✕</button></td>
                </tr>`;
        });
        
        document.getElementById('fboTotalQty').innerText = tQty + ' шт';
        document.getElementById('fboTotalCost').innerText = tCost.toLocaleString() + ' сум';
        document.getElementById('fboTotalNet').innerText = tNet.toLocaleString() + ' сум';
    }

    window.onload = fetchFullData;
</script>
</body>
</html>

